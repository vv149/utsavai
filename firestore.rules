rules_version = '2';

// UtsavAI never lets a browser talk to Firestore. Plans are read and written only by
// the Next.js server on Cloud Run through the server SDK with Application Default
// Credentials. Access control for edits lives in the API (edit-key hash check).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
