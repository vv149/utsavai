# UtsavAI Environment Variables

# Required in production (Vertex AI uses ADC, no key needed)
# For local dev with API key:
GEMINI_API_KEY=your-gemini-api-key-here

# GCP Project (required in production)
GCP_PROJECT=your-gcp-project-id

# Firestore named database (defaults to "utsavai")
FIRESTORE_DATABASE=utsavai

# Trusted proxy hops for X-Forwarded-For parsing (default: 1)
TRUSTED_PROXY_HOPS=1

# Rate limit scale factor (default: 1, set >1 for higher limits)
RATE_LIMIT_SCALE=1

# Node environment
NODE_ENV=development
